{
  "name": "aja-logistics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node -e \"const fs=require('fs'); fs.mkdirSync('build',{recursive:true}); fs.cpSync('dist','build',{recursive:true,force:true});\"",
    "start": "node dist/server.cjs",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','build','server.cjs']) fs.rmSync(p,{recursive:true,force:true});\"",
    "test": "npm run test:unit",
    "test:unit": "tsx --test src/lib/exchange/csvExportEngine.test.ts src/lib/exchange/exportClient.test.ts src/lib/exchange/exportPolicyResolver.test.ts src/lib/exchange/xlsxExportEngine.test.ts src/lib/exchange/importParsers/importParser.test.ts src/lib/exchange/importValidation.test.ts src/lib/exchange/importDuplicates.test.ts src/lib/analytics/analyticsMetricRegistry.test.ts src/utils/productResourceValidators.test.ts",
    "test:integration:firestore": "node scripts/run-firestore-tests.mjs",
    "test:integration:firestore:emulator": "node scripts/run-firestore-emulator-tests.mjs",
    "test:e2e:governance-workflows": "node scripts/run-governance-workflow-tests.mjs",
    "security:env": "node scripts/audit-production-env.mjs",
    "security:firestore-boundary": "node scripts/audit-firestore-boundary.mjs",
    "security:firestore-rules": "node scripts/audit-firestore-rules.mjs",
    "security:server-only-imports": "node scripts/audit-server-only-imports.mjs",
    "audit:client-repositories": "node scripts/audit-client-repository-imports.mjs",
    "smoke:product-resources": "node scripts/run-product-resource-smoke.mjs",
    "smoke:governance-api": "node scripts/run-governance-api-smoke.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run smoke:product-resources",
    "verify:staging": "npm run verify && npm run security:env && npm run security:server-only-imports && npm run security:firestore-boundary && npm run security:firestore-rules && npm run test:integration:firestore:emulator",
    "lint": "node --max-old-space-size=12288 ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "three": "^0.185.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
