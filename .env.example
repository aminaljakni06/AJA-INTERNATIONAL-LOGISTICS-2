# ==============================================================================
# AJA INTERNATIONAL LOGISTICS PLATFORM - ENTERPRISE MASTER ENVIRONMENT CONFIG
# ==============================================================================
# Platform Engine: Laravel 12.x / PHP 8.4 & Node.js Enterprise Full-Stack
# File: .env.example
# Purpose: Architecture Environment Variables Schema (EXAMPLE)
# Encoding: UTF-8 (Unix LF)
# Security: PLACEHOLDERS ONLY - DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS
# ==============================================================================

# ------------------------------------------------------------------------------
# 01. APPLICATION & CORE INFRASTRUCTURE
# ------------------------------------------------------------------------------
# APP_ASSET_URL: Base URL for static frontend assets and CDN distribution
APP_ASSET_URL=null

# APP_DEBUG: Enable or disable detailed error stack traces (true|false)
APP_DEBUG=true

# APP_ENV: Framework execution environment (local|testing|qa|staging|production)
APP_ENV=local

# APP_FAKER_LOCALE: Locale for database seeding and faker data generation
APP_FAKER_LOCALE=en_US

# APP_FALLBACK_LOCALE: Secondary translation fallback language code
APP_FALLBACK_LOCALE=en

# APP_KEY: Primary 256-bit encryption key generated via `php artisan key:generate`
APP_KEY=base64:your_application_encryption_key_placeholder=

# APP_LOCALE: Default primary application translation locale (ar|en)
APP_LOCALE=ar

# APP_MAINTENANCE_DRIVER: Maintenance mode state storage driver (file|cache)
APP_MAINTENANCE_DRIVER=file

# APP_NAME: Full legal entity application title
APP_NAME="AJA International Logistics Platform"

# APP_PORT: Network listening port for container ingress proxy
APP_PORT=3000

# APP_PREVIOUS_KEYS: Comma-separated prior APP_KEY values for key rotation decryption
APP_PREVIOUS_KEYS=null

# APP_TIMEZONE: Primary system timezone identifier
APP_TIMEZONE=Asia/Riyadh

# APP_URL: Canonical base URL for absolute link generation and webhooks
APP_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 02. LOGGING & MONITORING
# ------------------------------------------------------------------------------
# LOG_CHANNEL: Primary application logging driver (stack|single|daily|stderr|syslog)
LOG_CHANNEL=stack

# LOG_DEPRECATIONS_CHANNEL: Dedicated channel for PHP and framework deprecation logs
LOG_DEPRECATIONS_CHANNEL=null

# LOG_LEVEL: Minimum log verbosity threshold (debug|info|notice|warning|error|critical)
LOG_LEVEL=debug

# LOG_STACK: Comma-separated driver list for multi-target stack logging
LOG_STACK=single


# ------------------------------------------------------------------------------
# 03. CACHE & REDIS STORAGE
# ------------------------------------------------------------------------------
# CACHE_DRIVER: High-performance caching storage driver (redis|memcached|file|array)
CACHE_DRIVER=redis

# CACHE_PREFIX: Namespace prefix to prevent key collision across environments
CACHE_PREFIX=aja_cache_

# CACHE_STORE: Default cache repository store instance
CACHE_STORE=redis

# REDIS_CACHE_DB: Redis database index dedicated to application cache storage
REDIS_CACHE_DB=1

# REDIS_CLIENT: PHP Redis client extension driver (phpredis|predis)
REDIS_CLIENT=phpredis

# REDIS_CLUSTER_ENABLED: Enable enterprise distributed Redis Cluster mode
REDIS_CLUSTER_ENABLED=false

# REDIS_HOST: Primary Redis instance network IP address or hostname
REDIS_HOST=127.0.0.1

# REDIS_PASSWORD: Authentication password for secured Redis instance
REDIS_PASSWORD=your_redis_password_placeholder

# REDIS_PORT: Listening port number for Redis service
REDIS_PORT=6379

# REDIS_PREFIX: Global key prefix for all Redis operations
REDIS_PREFIX=aja_redis_

# REDIS_QUEUE_DB: Redis database index dedicated to background queue jobs
REDIS_QUEUE_DB=2

# REDIS_SESSION_DB: Redis database index dedicated to persistent user sessions
REDIS_SESSION_DB=0


# ------------------------------------------------------------------------------
# 04. SESSION & COOKIE MANAGEMENT
# ------------------------------------------------------------------------------
# SESSION_COOKIE: Security-prefixed session cookie name
SESSION_COOKIE=aja_session

# SESSION_DOMAIN: Strict domain scope (must be null when using __Host- cookie prefix)
SESSION_DOMAIN=null

# SESSION_DRIVER: Session state persistence driver (redis|database|file|array)
SESSION_DRIVER=redis

# SESSION_ENCRYPT: Encrypt session payload content on storage (true|false)
SESSION_ENCRYPT=true

# SESSION_LIFETIME: Session inactivity expiration duration in minutes
SESSION_LIFETIME=120

# SESSION_PATH: URL path scope constraint for application session cookie
SESSION_PATH=/

# SESSION_SECURE_COOKIE: Restrict cookie transmission strictly to HTTPS connection
SESSION_SECURE_COOKIE=true


# ------------------------------------------------------------------------------
# 05. QUEUE & BACKGROUND WORKERS
# ------------------------------------------------------------------------------
# QUEUE_CONNECTION: Asynchronous queue execution driver (redis|sqs|database|sync)
QUEUE_CONNECTION=redis

# QUEUE_FAILED_DRIVER: Storage handler for failed queue job tracking
QUEUE_FAILED_DRIVER=database-uuids


# ------------------------------------------------------------------------------
# 06. BROADCASTING & REALTIME SERVICES
# ------------------------------------------------------------------------------
# BROADCAST_CONNECTION: Realtime WebSocket broadcasting connection driver (reverb|pusher|log|null)
BROADCAST_CONNECTION=reverb

# BROADCAST_DRIVER: Primary WebSocket event broadcaster driver
BROADCAST_DRIVER=reverb


# ------------------------------------------------------------------------------
# 07. FILESYSTEM & AWS S3 STORAGE
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID: IAM access key ID for AWS object storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id_placeholder

# AWS_BUCKET: AWS S3 storage bucket name for file assets
AWS_BUCKET=aja-logistics-media-bucket

# AWS_DEFAULT_REGION: Primary AWS region identifier (e.g. me-central-1 Riyadh)
AWS_DEFAULT_REGION=me-central-1

# AWS_ENDPOINT: Custom S3 API endpoint URL for MinIO or local testing
AWS_ENDPOINT=null

# AWS_SECRET_ACCESS_KEY: IAM secret access key for AWS authentication
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_placeholder

# AWS_USE_PATH_STYLE_ENDPOINT: Enable path-style S3 URLs for compatibility with custom endpoints
AWS_USE_PATH_STYLE_ENDPOINT=false

# FILESYSTEM_DISK: Default storage disk driver (s3|public|local)
FILESYSTEM_DISK=s3

# FILESYSTEM_PUBLIC_DISK: Dedicated disk instance for publicly accessible static uploads
FILESYSTEM_PUBLIC_DISK=public

# MEDIA_MAX_FILE_SIZE_MB: Maximum allowed single media file upload size in megabytes
MEDIA_MAX_FILE_SIZE_MB=50

# STORAGE_PATH: Relative local storage directory path
STORAGE_PATH=storage


# ------------------------------------------------------------------------------
# 08. CONTENT DELIVERY NETWORK (CDN)
# ------------------------------------------------------------------------------
# CDN_ENABLED: Enable Cloudflare or AWS CloudFront CDN distribution (true|false)
CDN_ENABLED=true

# CDN_IMAGE_QUALITY: Automated image compression quality percentage (1-100)
CDN_IMAGE_QUALITY=85

# CDN_PROVIDER: Content delivery network edge provider (cloudflare|cloudfront)
CDN_PROVIDER=cloudflare

# CDN_URL: Base URL endpoint for edge-cached static assets
CDN_URL=https://cdn.ajalogistics.com


# ------------------------------------------------------------------------------
# 09. DATABASE & PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# DB_CHARSET: Primary database character set encoding
DB_CHARSET=utf8mb4

# DB_CONNECTION: Relational database management system driver (mysql|pgsql)
DB_CONNECTION=mysql

# DB_DATABASE: Target application database schema name
DB_DATABASE=aja_logistics_db

# DB_HOST: Primary database cluster network IP address or hostname
DB_HOST=127.0.0.1

# DB_PASSWORD: Database user authentication password
DB_PASSWORD=your_database_password_placeholder

# DB_PORT: Listening network port for RDBMS service
DB_PORT=3306

# DB_SSL_MODE: Transport security mode for database connections (PREFERRED|REQUIRED|VERIFY_FULL)
DB_SSL_MODE=PREFERRED

# DB_USERNAME: Database authentication username
DB_USERNAME=aja_app_user

# MYSQL_DATABASE: Alias for DB_DATABASE in Docker/k8s container environments
MYSQL_DATABASE=aja_logistics_db

# MYSQL_HOST: Alias for DB_HOST in containerized network configurations
MYSQL_HOST=127.0.0.1

# MYSQL_PASSWORD: Alias for DB_PASSWORD in containerized network configurations
MYSQL_PASSWORD=your_database_password_placeholder

# MYSQL_PORT: Alias for DB_PORT in containerized network configurations
MYSQL_PORT=3306

# MYSQL_ROOT_PASSWORD: Root administrator password for MySQL container bootstrapping
MYSQL_ROOT_PASSWORD=your_root_database_password_placeholder

# MYSQL_USERNAME: Alias for DB_USERNAME in containerized network configurations
MYSQL_USERNAME=aja_app_user


# ------------------------------------------------------------------------------
# 10. DOCKER & KUBERNETES CONTAINERIZATION
# ------------------------------------------------------------------------------
# DOCKER_APP_PORT: Host machine mapping port for containerized application
DOCKER_APP_PORT=3000

# DOCKER_CONTAINER_NAME: Unique Docker container execution label
DOCKER_CONTAINER_NAME=aja_logistics_app

# DOCKER_IMAGE_TAG: Container image release tag identifier
DOCKER_IMAGE_TAG=latest

# DOCKER_NODE_ENV: Node runtime environment inside container image
DOCKER_NODE_ENV=production

# DOCKER_PHP_VERSION: PHP engine major/minor version inside container
DOCKER_PHP_VERSION=8.4

# K8S_CLUSTER_NAME: Kubernetes cluster infrastructure identifier
K8S_CLUSTER_NAME=aja-k8s-cluster

# K8S_DEPLOYMENT_REPLICAS: Target pod instance count for Kubernetes deployment
K8S_DEPLOYMENT_REPLICAS=3

# K8S_MAX_SURGE: Maximum allowed pods above target replica count during rolling update
K8S_MAX_SURGE=25%

# K8S_MAX_UNAVAILABLE: Maximum allowed unavailable pods during rolling update
K8S_MAX_UNAVAILABLE=0

# K8S_NAMESPACE: Isolated Kubernetes deployment namespace
K8S_NAMESPACE=aja-logistics


# ------------------------------------------------------------------------------
# 11. HEALTH CHECKS & PERFORMANCE OPTIMIZATION
# ------------------------------------------------------------------------------
# HEALTH_CHECK_DATABASE: Verify database ping connectivity during health check probe (true|false)
HEALTH_CHECK_DATABASE=true

# HEALTH_CHECK_DISK_SPACE: Monitor free storage volume space in health status
HEALTH_CHECK_DISK_SPACE=true

# HEALTH_CHECK_ENDPOINT: REST route path for load balancer liveness/readiness probes
HEALTH_CHECK_ENDPOINT=/api/v1/health

# HEALTH_CHECK_REDIS: Verify Redis ping connectivity during health probe
HEALTH_CHECK_REDIS=true

# HEALTH_CHECK_TOKEN: Secret bearer token requirement for detailed health status diagnostic endpoint
HEALTH_CHECK_TOKEN=your_health_check_secret_token_placeholder

# OCTANE_HTTPS: Force HTTPS scheme URL generation under Laravel Octane engine
OCTANE_HTTPS=false

# OCTANE_MAX_REQUESTS: Worker process auto-recycle threshold limit to prevent memory leaks
OCTANE_MAX_REQUESTS=1000

# OCTANE_SERVER: High-throughput application server engine (frankenphp|swoole|roadrunner)
OCTANE_SERVER=frankenphp

# OCTANE_WORKERS: Number of persistent background worker processes per CPU core
OCTANE_WORKERS=4

# OPCACHE_ENABLE: Enable PHP Zend OPcache bytecode compilation engine (true|false)
OPCACHE_ENABLE=true

# OPCACHE_MEMORY_LIMIT_MB: OPcache shared memory buffer allocation size in megabytes
OPCACHE_MEMORY_LIMIT_MB=256

# OPCACHE_VALIDATE_TIMESTAMPS: Revalidate compiled script timestamps on file modification
OPCACHE_VALIDATE_TIMESTAMPS=true

# PHP_MEMORY_LIMIT: Maximum RAM memory consumption ceiling allowed per PHP process
PHP_MEMORY_LIMIT=512M


# ------------------------------------------------------------------------------
# 12. SCHEDULER & LOCALIZATION
# ------------------------------------------------------------------------------
# API_PREFIX: Global route path prefix for API endpoints
API_PREFIX=api

# API_RATE_LIMIT: Standard REST API rate limit request cap per minute
API_RATE_LIMIT=60

# API_VERSION: Default REST API major version path segment
API_VERSION=v1

# CORS_ALLOWED_HEADERS: Permitted HTTP header fields for cross-origin requests
CORS_ALLOWED_HEADERS="*"

# CORS_ALLOWED_METHODS: Permitted HTTP verbs for CORS preflight requests
CORS_ALLOWED_METHODS="GET, POST, PUT, PATCH, DELETE, OPTIONS"

# CORS_ALLOWED_ORIGINS: Permitted origin domains allowed to perform cross-origin AJAX calls
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://ajalogistics.com"

# CORS_SUPPORTS_CREDENTIALS: Allow credentials like cookies and HTTP auth headers in CORS
CORS_SUPPORTS_CREDENTIALS=true

# RATE_LIMIT_API_MAX_ATTEMPTS: Maximum API calls permitted within decay window
RATE_LIMIT_API_MAX_ATTEMPTS=60

# RATE_LIMIT_DECAY_MINUTES: Time window in minutes for rate limiting counter reset
RATE_LIMIT_DECAY_MINUTES=1

# RATE_LIMIT_LOGIN_MAX_ATTEMPTS: Maximum failed login attempts allowed before IP lockout
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5

# SCHEDULE_TIMEZONE: Target timezone for scheduled cron tasks
SCHEDULE_TIMEZONE=Asia/Riyadh


# ------------------------------------------------------------------------------
# 13. TRANSPORT & HTTP SECURITY
# ------------------------------------------------------------------------------
# BCRYPT_ROUNDS: Bcrypt hashing cost factor algorithm work factor
BCRYPT_ROUNDS=12

# CSP_ENABLED: Enable HTTP Content-Security-Policy security headers
CSP_ENABLED=true

# CSP_POLICY_DIRECTIVE: Directives governing trusted resource load policies
CSP_POLICY_DIRECTIVE="default-src self; script-src self nonce-{nonce}; style-src self unsafe-inline; img-src self data: https:; font-src self data:; connect-src self https: wss:; object-src none; frame-ancestors none;"

# CSP_REPORT_ONLY: Audit CSP violations without blocking browser execution
CSP_REPORT_ONLY=false

# CSP_REPORT_URI: Route endpoint for browser security breach reports
CSP_REPORT_URI=/api/v1/security/csp-report

# FORCE_HTTPS: Automatically redirect all HTTP requests to encrypted HTTPS
FORCE_HTTPS=true

# HSTS_ENABLE: Enable HTTP Strict-Transport-Security header enforcement
HSTS_ENABLE=true

# HSTS_INCLUDE_SUBDOMAINS: Apply HSTS rules recursively across all subdomains
HSTS_INCLUDE_SUBDOMAINS=true

# HSTS_MAX_AGE: HSTS caching duration limit enforced by browser in seconds
HSTS_MAX_AGE=31536000

# HSTS_PRELOAD: Enable browser preload list inclusion flag for HSTS
HSTS_PRELOAD=true

# SECURE_HEADER_PERMISSIONS_POLICY: Feature-policy restriction header for device hardware APIs
SECURE_HEADER_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(self), payment=(self)"

# SECURE_HEADER_REFERRER_POLICY: Controlling referrer header metadata broadcast scope
SECURE_HEADER_REFERRER_POLICY=strict-origin-when-cross-origin

# SECURE_HEADER_X_CONTENT_TYPE_OPTIONS: Prevent MIME-type sniffing vulnerabilities
SECURE_HEADER_X_CONTENT_TYPE_OPTIONS=nosniff

# SECURE_HEADER_X_FRAME_OPTIONS: Anti-clickjacking iframe restriction directive (DENY|SAMEORIGIN)
SECURE_HEADER_X_FRAME_OPTIONS=DENY

# TRUSTED_PROXIES: Trusted reverse proxy IP subnets for real client IP resolution
TRUSTED_PROXIES="*"

# TRUSTED_PROXY_HEADERS: Bitmask flags for parsing proxy header metadata
TRUSTED_PROXY_HEADERS="HEADER_X_FORWARDED_FOR|HEADER_X_FORWARDED_HOST|HEADER_X_FORWARDED_PORT|HEADER_X_FORWARDED_PROTO|HEADER_X_FORWARDED_AWS_ELB"


# ------------------------------------------------------------------------------
# 14. AUTHENTICATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# HORIZON_BALANCE: Queue balancing strategy for Laravel Horizon (auto|simple|false)
HORIZON_BALANCE=auto

# HORIZON_BASIC_AUTH_PASSWORD: Password requirement for Horizon dashboard basic authentication
HORIZON_BASIC_AUTH_PASSWORD=your_horizon_dashboard_password_placeholder

# HORIZON_BASIC_AUTH_USERNAME: Username requirement for Horizon dashboard basic authentication
HORIZON_BASIC_AUTH_USERNAME=admin

# HORIZON_PATH: URL path slug for accessing Horizon dashboard
HORIZON_PATH=horizon

# HORIZON_PREFIX: Redis key prefix namespace for Horizon metrics
HORIZON_PREFIX=aja_horizon_

# JWT_ALGORITHM: Cryptographic hashing algorithm for JWT token signatures
JWT_ALGORITHM=HS256

# JWT_BLACKLIST_ENABLED: Enable server-side token revocation blacklist
JWT_BLACKLIST_ENABLED=true

# JWT_EXPIRATION_MINUTES: Time-to-live expiration duration for access tokens
JWT_EXPIRATION_MINUTES=30

# JWT_PUBLIC_KEY: Public key path when using asymmetric encryption (RS256)
JWT_PUBLIC_KEY=null

# JWT_REFRESH_EXPIRATION_MINUTES: Time-to-live expiration duration for refresh tokens
JWT_REFRESH_EXPIRATION_MINUTES=10080

# JWT_SECRET: High-entropy secret key used to sign JWT authorization tokens
JWT_SECRET=your_high_entropy_jwt_secret_key_placeholder

# FIREBASE_PROJECT_ID: Firebase project used by server-side Admin SDK
FIREBASE_PROJECT_ID=gen-lang-client-0928410453

# FIRESTORE_DATABASE_ID: Named Firestore database used by the applet project
FIRESTORE_DATABASE_ID=ai-studio-remixremixajalog-b292032f-7329-4e53-b5da-095447d9b84b

# FIREBASE_SERVICE_ACCOUNT_JSON: Service account JSON for server-only Firebase Admin SDK.
# Prefer secret-manager injection in staging/production. Do not expose this to the browser.
FIREBASE_SERVICE_ACCOUNT_JSON=

# GOOGLE_APPLICATION_CREDENTIALS: Alternative path to a service account JSON file for local/server runtime.
GOOGLE_APPLICATION_CREDENTIALS=

# DEFAULT_ADMIN_PASSWORD / DEFAULT_STAFF_PASSWORD / DEFAULT_CUSTOMER_PASSWORD:
# Explicit local seed passwords for first-run demo accounts. Never reuse these in production.
DEFAULT_ADMIN_PASSWORD=replace_with_local_admin_seed_password
DEFAULT_STAFF_PASSWORD=replace_with_local_staff_seed_password
DEFAULT_CUSTOMER_PASSWORD=replace_with_local_customer_seed_password

# REVERB_ALLOWED_ORIGINS: Permitted WebSocket origin domains
REVERB_ALLOWED_ORIGINS="http://localhost:3000,https://ajalogistics.com"

# REVERB_APP_ID: Laravel Reverb WebSocket application identifier
REVERB_APP_ID=your_reverb_app_id_placeholder

# REVERB_APP_KEY: Public client key for establishing WebSocket connection
REVERB_APP_KEY=your_reverb_public_app_key_placeholder

# REVERB_APP_SECRET: Private authentication secret for broadcasting channel authorization
REVERB_APP_SECRET=your_reverb_private_app_secret_placeholder

# REVERB_MAX_PAYLOAD_SIZE: Maximum allowable payload byte size per WebSocket frame
REVERB_MAX_PAYLOAD_SIZE=1048576

# REVERB_SCHEME: Connection security scheme (http|https|ws|wss)
REVERB_SCHEME=wss

# SANCTUM_EXPIRATION: Stateful Personal Access Token expiration threshold in minutes
SANCTUM_EXPIRATION=60

# SANCTUM_STATEFUL_DOMAINS: Trusted frontend domains for stateful cookie authentication
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000"

# SANCTUM_TOKEN_PREFIX: Custom prefix prepended to issued Sanctum token strings
SANCTUM_TOKEN_PREFIX=aja_st_


# ------------------------------------------------------------------------------
# 14B. ADYEN PAYMENT GATEWAY CONFIGURATION (SANDBOX / TEST)
# ------------------------------------------------------------------------------
# ADYEN_API_KEY: Adyen Web Service API Key for Checkout REST endpoints
ADYEN_API_KEY=AQEhhm48N3f...your_adyen_test_api_key_placeholder

# ADYEN_CLIENT_KEY: Client key for Adyen Web Drop-in SDK authentication
ADYEN_CLIENT_KEY=test_WS384...your_adyen_test_client_key_placeholder

# ADYEN_ENVIRONMENT: Execution environment (TEST|LIVE)
ADYEN_ENVIRONMENT=TEST

# ADYEN_HMAC_KEY: Secret key for verifying Adyen webhook signature integrity
ADYEN_HMAC_KEY=your_adyen_hmac_secret_key_placeholder

# ADYEN_LIVE_ENDPOINT_PREFIX: Live endpoint prefix required strictly in LIVE mode (empty in TEST)
ADYEN_LIVE_ENDPOINT_PREFIX=

# ADYEN_MERCHANT_ACCOUNT: Adyen Merchant Account identifier
ADYEN_MERCHANT_ACCOUNT=AjaLogisticsECOM

# ADYEN_RETURN_URL: Default browser redirect URL after 3DS or payment completion
ADYEN_RETURN_URL=http://localhost:3000/customer/payments/adyen-result

# ADYEN_WEBHOOK_URL: Webhook receiver endpoint URL for asynchronous payment notifications
ADYEN_WEBHOOK_URL=http://localhost:3000/api/payments/adyen/webhook


# ------------------------------------------------------------------------------
# 15. FEATURE FLAGS & SMART CAPABILITIES
# ------------------------------------------------------------------------------
# FEATURE_AI_ENABLED: Master toggle for AI assistant & predictive logistics
FEATURE_AI_ENABLED=true

# FEATURE_ANALYTICS_ENABLED: Enable real-time business telemetry and reporting
FEATURE_ANALYTICS_ENABLED=true

# FEATURE_CHATBOT_ENABLED: Enable automated AI customer support chat agent
FEATURE_CHATBOT_ENABLED=true

# FEATURE_ERP_ENABLED: Enable core Enterprise Resource Planning integration
FEATURE_ERP_ENABLED=true

# FEATURE_TMS_ENABLED: Enable Transportation Management System capabilities
FEATURE_TMS_ENABLED=true

# FEATURE_TRACKING_ENABLED: Enable public smart shipment tracking experience
FEATURE_TRACKING_ENABLED=true

# FEATURE_WMS_ENABLED: Enable Warehouse Management System module
FEATURE_WMS_ENABLED=true


# ------------------------------------------------------------------------------
# 16. ENTERPRISE BUSINESS MODULE SWITCHES
# ------------------------------------------------------------------------------
# MODULE_ACCOUNTING_ENABLED: Enable general ledger & fiscal accounting module
MODULE_ACCOUNTING_ENABLED=true

# MODULE_ADMIN_PANEL_ENABLED: Enable central enterprise administrative control panel
MODULE_ADMIN_PANEL_ENABLED=true

# MODULE_CRM_ENABLED: Enable Customer Relationship Management module
MODULE_CRM_ENABLED=true

# MODULE_CUSTOMER_PORTAL_ENABLED: Enable self-service client portal dashboard
MODULE_CUSTOMER_PORTAL_ENABLED=true

# MODULE_CUSTOMS_ENABLED: Enable customs clearance & international compliance module
MODULE_CUSTOMS_ENABLED=true

# MODULE_FINANCE_ENABLED: Enable financial transactions & billing management module
MODULE_FINANCE_ENABLED=true

# MODULE_FLEET_ENABLED: Enable fleet vehicle & telemetry management module
MODULE_FLEET_ENABLED=true

# MODULE_HR_ENABLED: Enable Human Resources & workforce management module
MODULE_HR_ENABLED=true

# MODULE_INVENTORY_ENABLED: Enable multi-warehouse inventory control module
MODULE_INVENTORY_ENABLED=true

# MODULE_PROCUREMENT_ENABLED: Enable vendor procurement & purchasing order module
MODULE_PROCUREMENT_ENABLED=true

# MODULE_PUBLIC_API_ENABLED: Enable external partner public REST & GraphQL API
MODULE_PUBLIC_API_ENABLED=true

# MODULE_WAREHOUSE_ENABLED: Enable warehouse operations & fulfillment module
MODULE_WAREHOUSE_ENABLED=true


# ------------------------------------------------------------------------------
# 17. DEPLOYMENT & RELEASE CONFIGURATION
# ------------------------------------------------------------------------------
# APPLICATION_VERSION: Semantic application release version (e.g. 1.0.0)
APPLICATION_VERSION=1.0.0

# DEPLOYMENT_ENVIRONMENT: Target deployment environment identifier
DEPLOYMENT_ENVIRONMENT=local

# DEPLOYMENT_PROVIDER: Infrastructure runtime orchestrator (docker|kubernetes|aws|gcp)
DEPLOYMENT_PROVIDER=docker

# DEPLOYMENT_REGION: Infrastructure deployment cloud region identifier
DEPLOYMENT_REGION=me-central1

# DEPLOYMENT_STRATEGY: Release deployment execution strategy (direct|rolling|blue-green|canary)
DEPLOYMENT_STRATEGY=rolling

# DEPLOYMENT_VERSION: Git commit sha or CI build release candidate tag
DEPLOYMENT_VERSION=v1.0.0

# MAINTENANCE_MODE: Global application maintenance mode lock toggle
MAINTENANCE_MODE=false

# RELEASE_CHANNEL: Release distribution channel (dev|test|qa|rc|stable)
RELEASE_CHANNEL=stable

# ROLLBACK_ENABLED: Enable automated deployment rollback on health check failure
ROLLBACK_ENABLED=true


# ------------------------------------------------------------------------------
# 18. SCALING & INSTANCE MANAGEMENT
# ------------------------------------------------------------------------------
# AUTO_SCALING_ENABLED: Enable horizontal pod/container auto-scaling based on CPU/RAM
AUTO_SCALING_ENABLED=false

# LOAD_BALANCER_ENABLED: Enable upstream edge load balancer ingress routing
LOAD_BALANCER_ENABLED=false

# MAX_APPLICATION_INSTANCES: Maximum container instance replica ceiling for horizontal scaling
MAX_APPLICATION_INSTANCES=1

# MIN_APPLICATION_INSTANCES: Minimum guaranteed container instance count
MIN_APPLICATION_INSTANCES=1

# QUEUE_BALANCING: Dynamic queue worker load balancing strategy (off|simple|auto)
QUEUE_BALANCING=auto

# QUEUE_WORKERS: Concurrent background queue worker process count
QUEUE_WORKERS=2


# ------------------------------------------------------------------------------
# 19. PERFORMANCE OPTIMIZATION PROFILES
# ------------------------------------------------------------------------------
# CONFIG_CACHE: Pre-compiled configuration cache state (true|false)
CONFIG_CACHE=false

# EVENT_CACHE: Pre-compiled event and listener mapping cache state
EVENT_CACHE=false

# OCTANE_ENABLED: Enable high-concurrency Laravel Octane execution mode
OCTANE_ENABLED=false

# OPCACHE_ENABLED: Master OPcache bytecode caching switch
OPCACHE_ENABLED=false

# ROUTE_CACHE: Pre-compiled API and web route cache state
ROUTE_CACHE=false

# VIEW_CACHE: Pre-compiled Blade template view cache state
VIEW_CACHE=false


# ------------------------------------------------------------------------------
# 20. LOGGING & AUDIT PROFILES
# ------------------------------------------------------------------------------
# AUDIT_LOG_RETENTION_DAYS: Enterprise security audit trail log retention period in days
AUDIT_LOG_RETENTION_DAYS=30

# CENTRALIZED_LOGGING: Stream log events to centralized Datadog/ELK collector
CENTRALIZED_LOGGING=false

# LOG_RETENTION_DAYS: System application log file retention period in days
LOG_RETENTION_DAYS=30

# LOG_ROTATION_ENABLED: Enable automated daily log rotation and compression
LOG_ROTATION_ENABLED=true


# ------------------------------------------------------------------------------
# 21. DISASTER RECOVERY & BACKUP PROFILES
# ------------------------------------------------------------------------------
# BACKUP_ENABLED: Master automated database and storage backup toggle
BACKUP_ENABLED=false

# BACKUP_VERIFICATION: Automated backup archive integrity checksum verification
BACKUP_VERIFICATION=false

# DISASTER_RECOVERY_PLAN: Active disaster recovery policy specification document code
DISASTER_RECOVERY_PLAN=drp-standard-v1

# RECOVERY_MODE: Emergency read-only disaster recovery fallback state
RECOVERY_MODE=false
